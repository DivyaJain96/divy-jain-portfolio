# Web3Forms access key — add this in a local `.env` file (not committed).
# 1. Create a key at https://web3forms.com
# 2. Verify the inbox you want inquiries delivered to
# 3. Paste the access key below (replace YOUR_WEB3FORMS_ACCESS_KEY)
# 4. Restart `npm run dev` after changing this file
#
# The access key is a public client key. Never put Gmail/SMTP passwords here.
#
# Vercel: Project Settings → Environment Variables → add the same name/value
# for Production, Preview, and Development, then redeploy.
VITE_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# Optional public site URL used for canonical and Open Graph image paths.
# Example: https://divyjain.dev
# VITE_SITE_URL=
